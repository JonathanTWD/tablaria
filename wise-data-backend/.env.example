NODE_ENV=development
# HTTP port for the API
PORT=3000
# Must match the credentials in the root .env used by Docker Compose
DATABASE_URL=postgresql://wisedata:wisedata@127.0.0.1:5433/wisedata?schema=public
# Separate database for e2e tests; it is migrated and wiped by the test setup
TEST_DATABASE_URL=postgresql://wisedata:wisedata@127.0.0.1:5433/wisedata_test?schema=public
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Reverse proxies in front of the API (0 locally; 1 behind a single proxy/rewrite)
TRUST_PROXY_HOPS=0
# Public URL of the frontend, used for links in emails
APP_URL=http://localhost:5173

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Email: "smtp" (Mailpit in development) or "resend" (production)
MAIL_TRANSPORT=smtp
MAIL_FROM=WiseData <no-reply@wisedata.local>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Required when MAIL_TRANSPORT=resend
# RESEND_API_KEY=

# "Try the demo": temporary accounts with example tables (true by default)
DEMO_ENABLED=true
