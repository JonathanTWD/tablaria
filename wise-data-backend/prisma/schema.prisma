generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum ColumnType {
  text
  number
  date
  boolean
  select
  currency
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  // Set only for demo accounts, which are deleted with all their data after this date.
  demoExpiresAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  tables        InventoryTable[]

  @@index([demoExpiresAt])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  // Tokens issued by rotating the same login share a family, so reuse revokes all of them.
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

model InventoryTable {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  columns Column[]
  records Record[]

  @@index([ownerId, updatedAt])
  @@map("inventory_tables")
}

model Column {
  id           String     @id @default(uuid()) @db.Uuid
  tableId      String     @db.Uuid
  name         String
  type         ColumnType
  position     Int
  required     Boolean    @default(false)
  defaultValue Json?
  // Type-specific settings: choices for `select`, ISO 4217 code for `currency`,
  // optional low-stock threshold (`alertBelow`) for `number`.
  options      Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  table InventoryTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, name])
  @@index([tableId, position])
  @@map("columns")
}

model Record {
  id        String   @id @default(uuid()) @db.Uuid
  tableId   String   @db.Uuid
  // Cell values keyed by column id: { [columnId]: value }.
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table InventoryTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, createdAt])
  @@index([data], type: Gin)
  @@map("records")
}
