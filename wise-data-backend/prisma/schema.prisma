generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Rank: VIEWER < EDITOR < ADMIN < OWNER. Table shares only grant VIEWER or EDITOR.
enum Role {
  VIEWER
  EDITOR
  ADMIN
  OWNER
}

enum ColumnType {
  text
  number
  date
  boolean
  select
  currency
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  // Set only for demo accounts, which are deleted with all their data after this date.
  demoExpiresAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens        RefreshToken[]
  emailTokens          EmailToken[]
  personalOrganization Organization?
  memberships          Membership[]
  tableShares          TableShare[]
  createdTables        InventoryTable[]
  sentInvitations      Invitation[]

  @@index([demoExpiresAt])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  // Tokens issued by rotating the same login share a family, so reuse revokes all of them.
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

/// Every table belongs to an organization. Each user has a personal one (personalForId),
/// deleted with the user; shared work lives in organizations with several members.
model Organization {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  personalForId String?  @unique @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  personalFor User?            @relation(fields: [personalForId], references: [id], onDelete: Cascade)
  memberships Membership[]
  tables      InventoryTable[]

  @@map("organizations")
}

model Membership {
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           Role
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Access to a single table for someone outside its organization.
model TableShare {
  tableId   String   @db.Uuid
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  table InventoryTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tableId, userId])
  @@index([userId])
  @@map("table_shares")
}

model InventoryTable {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  createdById    String?  @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  columns      Column[]
  records      Record[]
  shares       TableShare[]
  invitations  Invitation[]

  @@index([organizationId, updatedAt])
  @@map("inventory_tables")
}

model Column {
  id           String     @id @default(uuid()) @db.Uuid
  tableId      String     @db.Uuid
  name         String
  type         ColumnType
  position     Int
  required     Boolean    @default(false)
  defaultValue Json?
  // Type-specific settings: choices for `select`, ISO 4217 code for `currency`,
  // optional low-stock threshold (`alertBelow`) for `number`.
  options      Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  table InventoryTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, name])
  @@index([tableId, position])
  @@map("columns")
}

model Record {
  id        String   @id @default(uuid()) @db.Uuid
  tableId   String   @db.Uuid
  // Cell values keyed by column id: { [columnId]: value }.
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table InventoryTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, createdAt])
  @@index([data], type: Gin)
  @@map("records")
}

/// An emailed invitation to a table. Only the token's hash is stored; rows are
/// kept after acceptance, revocation and even the table's deletion (tableId
/// becomes null), so the sending limits count every email ever sent.
model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  tableId     String?   @db.Uuid
  email       String
  role        Role
  tokenHash   String    @unique
  invitedById String?   @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  table     InventoryTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  invitedBy User?           @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([tableId])
  @@index([email, createdAt])
  @@index([invitedById, createdAt])
  @@map("invitations")
}
