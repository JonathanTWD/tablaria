NODE_ENV=development
# HTTP port for the API
PORT=3000
# Must match the credentials in the root .env used by Docker Compose
DATABASE_URL=postgresql://tablaria:tablaria@127.0.0.1:5433/tablaria?schema=public
# Separate database for e2e tests; it is migrated and wiped by the test setup
TEST_DATABASE_URL=postgresql://tablaria:tablaria@127.0.0.1:5433/tablaria_test?schema=public
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Reverse proxies in front of the API (0 locally; 1 behind a single proxy/rewrite)
TRUST_PROXY_HOPS=0
# Public URL of the frontend, used for links in emails
APP_URL=http://localhost:5173
# Realtime updates (WebSocket). Unset: the browser connects through the app's own /api.
# Set it when the frontend's /api proxy can't carry WebSockets (e.g. a static host's rewrite):
# REALTIME_URL=wss://your-api.example.com/api/realtime

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Email: "smtp" (Mailpit in development) or "resend" (production)
MAIL_TRANSPORT=smtp
MAIL_FROM=Tablaria <no-reply@tablaria.local>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Required when MAIL_TRANSPORT=resend
# RESEND_API_KEY=

# "Try the demo": temporary accounts with example tables (true by default)
DEMO_ENABLED=true

# Attachments (photos and PDFs of records). Without a bucket they are saved in
# STORAGE_DIR (default: ./.storage) in development, and uploads are off in production.
# STORAGE_DIR=
# Any S3-compatible bucket, private (e.g. Filebase: https://s3.filebase.com, region "auto").
# Set all four, or none:
# STORAGE_ENDPOINT=
# STORAGE_REGION=auto
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
