generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Rank: VIEWER < EDITOR < ADMIN < OWNER. Table shares only grant VIEWER or EDITOR.
enum Role {
  VIEWER
  EDITOR
  ADMIN
  OWNER
}

/// How a stock movement came about (ADR-024).
enum StockMovementKind {
  IN
  OUT
  COUNT
  EDIT
  IMPORT
}

/// What happened in a table (ADR-025).
enum ActivityAction {
  RECORD_CREATED
  RECORD_UPDATED
  RECORD_DELETED
  RECORDS_IMPORTED
  COLUMN_CREATED
  COLUMN_UPDATED
  COLUMN_DELETED
  STOCK_MOVED
}

enum ColumnType {
  text
  number
  date
  boolean
  select
  currency
  relation
  lookup
  rollup
  formula
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  // Set only for demo accounts, which are deleted with all their data after this date.
  demoExpiresAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens        RefreshToken[]
  emailTokens          EmailToken[]
  personalOrganization Organization?
  memberships          Membership[]
  tableShares          TableShare[]
  createdTables        InventoryTable[]
  sentInvitations      Invitation[]
  stockMovements       StockMovement[]
  activityEvents       ActivityEvent[]
  publicLinks          PublicLink[]
  attachments          Attachment[]
  savedViews           SavedView[]

  @@index([demoExpiresAt])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  // Tokens issued by rotating the same login share a family, so reuse revokes all of them.
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

/// Every table belongs to an organization. Each user has a personal one (personalForId),
/// deleted with the user; shared work lives in organizations with several members.
model Organization {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  personalForId String?  @unique @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  personalFor User?            @relation(fields: [personalForId], references: [id], onDelete: Cascade)
  memberships Membership[]
  tables      InventoryTable[]
  invitations Invitation[]

  @@map("organizations")
}

model Membership {
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           Role
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Access to a single table for someone outside its organization.
model TableShare {
  tableId   String   @db.Uuid
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  table InventoryTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tableId, userId])
  @@index([userId])
  @@map("table_shares")
}

model InventoryTable {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  createdById    String?  @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  columns        Column[]
  records        Record[]
  shares         TableShare[]
  stockMovements StockMovement[]
  activityEvents ActivityEvent[]
  publicLink     PublicLink?
  invitations    Invitation[]
  savedViews     SavedView[]

  @@index([organizationId, updatedAt])
  @@map("inventory_tables")
}

model Column {
  id           String     @id @default(uuid()) @db.Uuid
  tableId      String     @db.Uuid
  name         String
  type         ColumnType
  position     Int
  required     Boolean    @default(false)
  // No two records of the table may hold the same value (ADR-023).
  unique       Boolean    @default(false)
  stock        Boolean    @default(false)
  defaultValue Json?
  // Type-specific settings: choices for `select`, ISO 4217 code for `currency`,
  // optional low-stock threshold (`alertBelow`) for `number`.
  options      Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  table          InventoryTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@unique([tableId, name])
  @@index([tableId, position])
  @@map("columns")
}

model Record {
  id        String   @id @default(uuid()) @db.Uuid
  tableId   String   @db.Uuid
  // Cell values keyed by column id: { [columnId]: value }.
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table          InventoryTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  attachments    Attachment[]

  @@index([tableId, createdAt])
  @@index([data], type: Gin)
  @@map("records")
}

/// An emailed invitation to a table or to an organization. Only the token's
/// hash is stored; rows are kept after acceptance, revocation and even the
/// target's deletion (its id becomes null), so the sending limits count every
/// email ever sent.
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  tableId        String?   @db.Uuid
  organizationId String?   @db.Uuid
  email          String
  role           Role
  tokenHash      String    @unique
  invitedById    String?   @db.Uuid
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  table        InventoryTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  invitedBy    User?           @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([tableId])
  @@index([organizationId])
  @@index([email, createdAt])
  @@index([invitedById, createdAt])
  @@map("invitations")
}

/// Every change of a stock column of a record, with who made it (ADR-024).
model StockMovement {
  id        String            @id @default(uuid()) @db.Uuid
  tableId   String            @db.Uuid
  recordId  String            @db.Uuid
  columnId  String            @db.Uuid
  /// Null once the account is deleted: the movement stays, without its author.
  userId    String?           @db.Uuid
  kind      StockMovementKind
  delta     Float
  balance   Float
  note      String?
  createdAt DateTime          @default(now())

  table  InventoryTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  record Record         @relation(fields: [recordId], references: [id], onDelete: Cascade)
  column Column         @relation(fields: [columnId], references: [id], onDelete: Cascade)
  user   User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([recordId, createdAt])
  @@index([tableId, createdAt])
  @@index([columnId])
  @@index([userId])
  @@map("stock_movements")
}

/// Who did what in a table, newest first (ADR-025).
model ActivityEvent {
  id        String         @id @default(uuid()) @db.Uuid
  tableId   String         @db.Uuid
  /// Null once the account is deleted.
  userId    String?        @db.Uuid
  action    ActivityAction
  /// No foreign key: the event outlives the record.
  recordId  String?        @db.Uuid
  /// The record's or column's name when it happened.
  label     String?
  details   Json           @default("{}")
  createdAt DateTime       @default(now())

  table InventoryTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tableId, createdAt])
  @@index([userId])
  @@map("activity_events")
}

/// A table's read-only link for anyone who has it (ADR-026). At most one per table.
model PublicLink {
  id          String   @id @default(uuid()) @db.Uuid
  tableId     String   @unique @db.Uuid
  /// SHA-256 of the token: the link itself is shown once, when it's created.
  tokenHash   String   @unique
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  table     InventoryTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("public_links")
}

/// A photo or document of a record, stored in object storage under its id (ADR-039).
model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  /// Null once the record is gone, however it went (the record, its table, its
  /// space or its owner's account): the file still has to be removed from
  /// storage, and the cleanup deletes the row after it.
  recordId     String?  @db.Uuid
  uploadedById String?  @db.Uuid
  name         String
  contentType  String
  size         Int
  createdAt    DateTime @default(now())

  record     Record? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([recordId, createdAt])
  @@index([uploadedById])
  @@map("attachments")
}

/// A named search, filters, sort and grouping of a table, for everyone who can open it (ADR-041).
model SavedView {
  id          String   @id @default(uuid()) @db.Uuid
  tableId     String   @db.Uuid
  createdById String?  @db.Uuid
  name        String
  /// SavedViewQuery: search, sort, order, filters, group and pageSize.
  view        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  table     InventoryTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tableId, name])
  @@index([createdById])
  @@map("saved_views")
}
