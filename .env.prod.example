# Production stack (docker-compose.prod.yml). Copy to .env.prod and fill in.

# Database
POSTGRES_USER=wisedata
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
POSTGRES_DB=wisedata

# Public URL where users open WiseData (used for email links and CORS)
APP_URL=http://localhost:8080
WEB_PORT=8080

# At least 32 characters:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Email: "smtp" with the bundled Mailpit (--profile mailpit) or "resend"
MAIL_TRANSPORT=smtp
MAIL_FROM=WiseData <no-reply@wisedata.local>
SMTP_HOST=mailpit
SMTP_PORT=1025
# Required when MAIL_TRANSPORT=resend
RESEND_API_KEY=
