# Production stack (docker-compose.prod.yml). Copy to .env.prod and fill in.

# Database
POSTGRES_USER=tablaria
# Only letters, digits, - and _: it is placed inside the database URL as is.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
POSTGRES_DB=tablaria

# Public URL where users open Tablaria (used for email links and CORS)
APP_URL=http://localhost:8080
WEB_PORT=8080

# Session cookies are Secure (HTTPS only) by default; browsers also accept them on
# http://localhost. Set to false only to serve over plain HTTP from another host,
# such as a server on your local network.
COOKIE_SECURE=

# "Probar la demo": temporary accounts with example tables, deleted after 24 h
DEMO_ENABLED=true

# At least 32 characters:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Email: "smtp" with the bundled Mailpit (--profile mailpit) or "resend"
MAIL_TRANSPORT=smtp
MAIL_FROM=Tablaria <no-reply@tablaria.local>
SMTP_HOST=mailpit
SMTP_PORT=1025
# Required when MAIL_TRANSPORT=resend
RESEND_API_KEY=

# Attachments: a private S3-compatible bucket (e.g. Filebase). Without one,
# uploads are off. Set all four, or none.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
