{
  "name": "@wisedata/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Types, validation schemas and constants shared by the WiseData frontend and backend.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/write-esm-package.mjs",
    "dev": "tsc -p tsconfig.esm.json --watch",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
