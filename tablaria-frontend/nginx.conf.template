# Rendered at start-up by the nginx image; ${API_UPSTREAM} and ${STORAGE_ORIGIN}
# come from the environment.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    # Don't advertise the nginx version in headers or error pages.
    server_tokens off;

    # Declared once here: a location with its own add_header would drop these,
    # so caching below uses `expires` instead.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Scripts, data and fonts only from this origin. Inline styles stay allowed:
    # React style props and the UI library's positioning rely on them.
    # Images may also come from the attachments bucket, where the API redirects (ADR-039).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: ${STORAGE_ORIGIN}; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # Realtime updates: a WebSocket, so the upgrade headers must be passed on
    # and the connection may stay idle (the API pings every 30 s).
    location = /api/realtime {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite fingerprints these file names, so they can be cached for a year.
    location /assets/ {
        expires 1y;
    }

    # Client-side routes all serve the app shell, which is always revalidated.
    location / {
        try_files $uri /index.html;
        expires -1;
    }
}
